[Unit]
Description=Corpus literature review manager
After=network.target

[Service]
Type=simple
User=corpus
Group=corpus
WorkingDirectory=/opt/corpus
EnvironmentFile=/etc/corpus/corpus.env
ExecStart=/opt/corpus/.venv/bin/python /opt/corpus/run.py --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/corpus

[Install]
WantedBy=multi-user.target
