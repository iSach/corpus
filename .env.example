# Shell assignments for Corpus. The application reads environment variables;
# it does not load this file automatically. Copy to /etc/corpus/corpus.env,
# replace the placeholders, and chmod 0640 (root:corpus).

CORPUS_DATA_DIR=/var/lib/corpus/data
CORPUS_PDF_CACHE=/var/lib/corpus/data/pdfs
CORPUS_CACHE_MAX_BYTES=10737418240
CORPUS_DEDUPE_THRESHOLD=0.91

# Set both secrets explicitly in production. Do not leave placeholders active.
CORPUS_PASSWORD=change-this-login-password
CORPUS_INGEST_TOKEN=change-this-agent-token

# Public address used in invitation links. Set this before inviting people.
CORPUS_PUBLIC_ORIGIN=https://literature.example.org
# Optional initial administrator email. Existing password-only login still works.
# CORPUS_ADMIN_EMAIL=you@example.org

# Optional automatic invitation email. Without these, create a link in PEOPLE
# and copy it or open it in your email app. Use an authenticated SMTP sender;
# CORPUS_SMTP_FROM can be an address on your own verified domain.
# CORPUS_SMTP_HOST=smtp.example.org
# CORPUS_SMTP_PORT=587
# CORPUS_SMTP_SECURITY=starttls
# CORPUS_SMTP_USERNAME=
# CORPUS_SMTP_PASSWORD=
# CORPUS_SMTP_FROM=corpus@example.org
# For implicit TLS use CORPUS_SMTP_SECURITY=ssl and CORPUS_SMTP_PORT=465.

# JSON, kept on one shell-quoted line.
CORPUS_FIELDS='[{"id":"unfiled","label":"Unfiled"}]'

# TLS is terminated by nginx. The SQL console is behind the normal login gate;
# set CORPUS_SQL_LOCAL_ONLY=1 for loopback-only access (use an SSH tunnel).
CORPUS_SECURE_COOKIE=1
CORPUS_SQL_LOCAL_ONLY=0

# Enable passkeys at the exact public HTTPS origin; no path or trailing slash.
# CORPUS_PASSKEY_ORIGIN=https://literature.example.org

# Published-version checks for arXiv preprints (on by default). A free
# Semantic Scholar key makes ICLR/ICML/AISTATS lookups reliable.
# CORPUS_VENUE_CHECKS=1
# CORPUS_S2_API_KEY=
# CORPUS_OPENALEX_API_KEY=

# Development only, and only with a loopback bind. Leave disabled in production.
# CORPUS_DEV=1

# Automatic abstract reviews (Anthropic). Server-side secret; never sent to the browser.
# New and existing unassessed Inbox papers are processed when a key is configured.
# ANTHROPIC_API_KEY=
# CORPUS_AI_MODEL=claude-sonnet-5-5
# CORPUS_AI_REVIEWS=1
