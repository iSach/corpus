# Shell assignments for Corpus. The application reads environment variables;
# it does not load this file automatically. Copy to /etc/corpus/corpus.env,
# replace the placeholders, and chmod 0640 (root:corpus).

CORPUS_DATA_DIR=/var/lib/corpus/data
CORPUS_PDF_CACHE=/var/lib/corpus/data/pdfs
CORPUS_CACHE_MAX_BYTES=10737418240
CORPUS_DEDUPE_THRESHOLD=0.91

# Set both secrets explicitly in production. Do not leave placeholders active.
CORPUS_PASSWORD=change-this-login-password
CORPUS_INGEST_TOKEN=change-this-agent-token

# JSON, kept on one shell-quoted line.
CORPUS_FIELDS='[{"id":"sbi-pretrain","label":"SBI · pretraining"},{"id":"diff-compose","label":"Diffusion · composition"},{"id":"unfiled","label":"unfiled"}]'

# TLS is terminated by nginx. The SQL console is behind the normal login gate;
# set CORPUS_SQL_LOCAL_ONLY=1 for loopback-only access (use an SSH tunnel).
CORPUS_SECURE_COOKIE=1
CORPUS_SQL_LOCAL_ONLY=0

# Development only, and only with a loopback bind. Leave disabled in production.
# CORPUS_DEV=1
